	"902fc2d9af2d22a9": "방 참가",
	"907199c63f87bffc": "[Conpherence]",
	"90e2fca9e9906b83": "방",
	"91b1f7f95e448291": "Conpherence를 실제로 업데이트 하는 데이터를 지정해야 합니다.",
	"969889716d8228bf": "참가 가능한 방",
	"9c94926a7d498414": "새 conpherence 스레드를 만듭니다.",
	"9d15284398ed2533": "방 제목으로 검색합니다.",
	"9d572da1024594cb": "복숭아색",
	"a0cccc661b0d8700": "비공개 방",
	"a36ef8aba22905e2": "라이트",
	"a797e30923ac1be5": "테마",
	"b7431976cdc0776d": "새로운 방",
	"b958df3f3f559835": "지속적인 채팅",
	"b969680a4943d3e0": "경고음",
	"c04640995b54b653": "Conpherence 상세 정보",
	"c064322ad3308e55": "방 작업",
	"c0bcd28cc3b02deb": "이 메서드는 구식이며 향후 더 이상 사용되지 않을 예정입니다. 새로운 코드에서는 대신 \"conpherence.edit\"을 사용해야 합니다.",
	"c1e68746a7e963d4": "소리 없음",
	"c5d24864ed2d2d69": "방 참가자",
	"c94956e6eb072901": "$1님이 방에 참가했습니다.",
	"ca8f114e60efd68a": "방 찾아보기",
	"cac4ec9459a75d22": "$1 마지막 업데이트",
	"cd3dcdef6a29e058": "정말로 이 방을 나가겠습니까?",
	"cd56e0839d06af74": "참가자",
	"cfa0bbcc2389ead0": "Conpherence에 오신걸 환영합니다",
	"d176bbfc5dd76359": "방에 참가하면 알림 설정을 이용할 수 있습니다.",
	"d1fc8e9fdf1cdce6": "$1님이 이 방 주제를 제거했습니다.",
	"d3e33cb72fc470f3": "창 최소화",
	"d4f0b79d8cb85681": "로그인 후 방에 참가하면 알림 설정을 이용할 수 있습니다.",
	"d66d263f630a972f": "추후에 초대 받지 않는 이상, 다시 참가할 수 없게 됩니다.",
	"dd74c7d3444bf111": "방에 있는 참가자들이 언제든지 볼 수 있습니다.",
	"debf82431ce01507": "로그인한 사용자가 특정 Conpherence 방에서 수행한 트랜잭션을 조회합니다. Conpherence 방은 ID 또는 PHID로 지정할 수 있습니다. 또는, 제한 및 오프셋 값을 지정하여 로그인한 사용자의 Conpherence 방 내 최근 트랜잭션을 조회할 수 있습니다.",
	"e02f9589e433ea2e": "$1님이 $2에 대한 이 방 주제를 제거했습니다.",
	"e69e267f745199f8": "방 사진 편집하기",
	"e69eb95cec71f4bd": "참가자 제거하기",
	"e8153b6866c30559": "창 숨기기",
	"ec0ec93cc9f1d8e6": "추후에 방에 다시 참가할 수 없게 됩니다.",
	"ecfc9a722e9c1113": "새로운 방 주제입니다.",
	"f03d34e0e823043c": "Conpherence에서 보기",
	"f3adf7d54448098e": "추후에 방에 다시 참가할 수 없게 되지만, 다른 사람이 초대해 줄 수는 있습니다.",
	"f8c0387223ced9fc": "폭",
	"fc8d44e10d8511d4": "주제는 $1자를 초과할 수 없습니다.",
	"fd0bf50c90680c30": "$1님이 방 이미지를 업데이트했습니다.",
	"fda25492c9a7642a": "Conpherence를 사용하면 다른 사람들과 소통할 수 있는 공개 또는 비공개 방을 만들 수 있습니다.",
	"ff210658aa960ff2": "제목을 지정해야 합니다."
}
