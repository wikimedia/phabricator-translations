	"0b126000b8497001": "ஆங்கிலம் (கனடா)",
	"0e0fe51c50f1dab7": "'$1' கோப்பைத் திறக்க முடியவில்லை.",
	"21059ba056e7f2d8": "நூலகத்தை மேம்படுத்த முடியவில்லை: $1",
	"21a6c988047ced56": "கோப்பு பிழை",
	"23810714c293c89a": "நூலகத்தில் பிழை",
	"25dcf3854308d1cf": "அலகு சரி",
	"2758e3273dd1670b": "தோல்வி",
	"2da600bf94048431": "பதிப்பு",
	"2db226ae6a2200c9": "மறுஆய்வு",
	"2ff4e53e2b802e1e": "உலகளாவிய மாறிலிகள்",
	"302074a782b9c50a": "கோப்புகள் புதிய வரியில் முடிவடைய வேண்டும்.",
	"3ad465ce2b95e12d": "உடைந்தது",
	"3da474537ac378c6": "தவிர்",
	"3deb7456519697ec": "வகை",
	"41816017b3794822": "பயனர் \"$1\"",
	"41ff354b2b330bd1": "வகுப்பு",
	"431de839c3cfa8f3": "தவிர்",
	"441bda6cd85689e4": "நீக்கப்பட்டது",
	"449a05945635af92": "சமர்ப்பித்தல்",
	"475f96eca831d080": "பிரதிகள்",
	"49654dcbd95942ac": "மேம்படுத்துவதற்கு: $1",
	"4c279770c59fa93d": "<இயல்பிருப்பு>",
	"4e6302ed03494c90": "தொடரவும்?",
	"57042281fe387e13": "இனமறியாக் கட்டளை",
	"61a0572c4893ef34": "ஏற்கப்பட்டது",
	"63604a84080ff586": "உள்நுழைக",
	"66898864b47fde77": "$1 ($2) $3",
	"6c690fcd76c87814": "வெற்றி!",
	"6d33fa56bdf01c3a": "பணியைத் தொடங்கவும் அல்லது தொடரவும்.",
	"6e288959d3443bce": "இணை",
	"709a23220f2c3d64": "பெயர்",
	"753bc95141d3a3d0": "மதிப்பீட்டாளர்கள்: $1",
	"768e0c1c69573fb5": "தலைப்பு",
	"771e05f27b99fd59": "இணைப்பு துண்டிக்கப்பட்டது",
	"77487e6fbc8847da": "ஆங்கிலம் (மிகவும் அருமை)",
	"7ab5e906a1b8cbc1": "(வெற்று மரம்)",
	"7c3c7dd08ef396cb": "பிற இடங்கள்: $1",
	"82610b432a397965": "'தேதி:' என எதிர்பார்க்கப்படுகிறது.",
	"8295b736050208f7": "அறிவுரை",
	"852abd07db2ff431": "உண்மையான மதிப்பு",
	"883e44da0714454b": "ஒரு நகல் $1 ஆக சேமிக்கப்பட்டது.",
	"886cbff9d9df761e": "முன்னுரிமை",
	"887637bb8904003c": "தேவையற்ற அரைப்புள்ளி",
	"88d86b7721d58764": "மூடப்பட்டது",
	"89f89c02cf47e091": "அடையாள எண்",
	"8c6ad23a826eb50f": "கலத்தல்",
	"8dfa8258e8c8097c": "பெயர் பிழை",
	"a310b976aa8a3fd0": "தள்ளுதல்",
	"a3cbb98ddf5ee976": "கோப்பின் பெயர்",
	"a8ad860c15810cce": "குறிப்பு",
	"a9d371451b6909ac": "பெயர்",
	"ac02b41eaa3c992b": "\"$1\" என்பது ஒரு துல்லியமான அளவு அல்ல.",
	"b28c1e89bcdccffd": "மறுபெயர்",
	"b449f862b7314582": "மாற்றியமைக்கப்பட்ட '$1' கோப்புகள்:",
	"bdaa0203ef6e01a7": "மேம்படுத்தப்பட்டது",
	"c0b885fe691bafc5": "விண்ணப்பிக்கப்பட்டது",
	"d33aea3239497131": "[$1] பணிபுரிகிறது...",
	"d659313613786cd2": "இடையூறு",
	"d879d968b0adce01": "விண்ணப்பிக்கப்பட்டது",
	"dad39ba788d6c955": "திரும்பவும்",
	"dc353487021afbdd": "கேட்பது.",
	"def8aff516888b22": "கோப்பு தரவைப் பதிவேற்ற முடியவில்லை: $1",
	"e17457c93eb73cb8": "இந்த உதவியை காட்டுங்கள்.",
	"e3bb3273c3d27a35": "மேம்படுத்துதல்",
	"e6d6434c5309a905": "தொலை \"$1\"",
	"f34fb6e3669dfd5b": "கைவிடப்பட்டது",
	"f5e109d4609b19a6": "மோசமான கோப்பு பெயர்",
	"fd3edc641024a335": "எச்சரிக்கை"
}
