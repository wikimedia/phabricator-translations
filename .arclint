{
  "linters": {
    "chmod": {
      "type": "chmod"
    },
    "filename": {
      "type": "filename"
    },
    "merge-conflict": {
      "type": "merge-conflict"
    },
    "phutil-library": {
      "type": "phutil-library",
      "include": "(\\.php$)"
    },
    "phpast": {
      "type": "phpast",
      "include": "(\\.php$)",
      "standard": "phutil.phpast",
      "phpast.php-version": "7.2.25"
    },
    "json": {
      "type": "json",
      "include": [
        "(^\\.arclint$)",
        "(\\.json$)"
      ]
    },

    "spelling": {
      "type": "spelling",
      "exclude": [
        "(projects/.*\\.json)",
        "(src/translations/.*\\.php)"
      ]
    },
    "text": {
      "type": "text",
      "text.max-line-length": 120,
      "exclude": [
        "(projects/.*\\.json)",
        "(src/translations/.*\\.php)"
      ]
    }
  }
}
